{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubrix.local/schemas/destination.schema.json",
  "title": "IncuBrix Destination",
  "type": "object",
  "additionalProperties": false,
  "required": ["destination_id", "name", "url", "platform_key", "surface", "category", "audience_tags", "language", "geo", "est_audience", "rules_url", "frequency_cap", "self_promo_allowed", "link_policy", "disclosure_required", "automation_allowed", "connector_key", "relevance_score", "relevance_reason", "level", "last_certified_at", "spec", "content_types"],
  "properties": {
    "destination_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "url": { "type": "string", "format": "uri" },
    "platform_key": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "audience_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "language": { "type": "string", "minLength": 2, "maxLength": 35 },
    "geo": { "type": ["string", "null"] },
    "est_audience": { "type": ["integer", "null"], "minimum": 0 },
    "rules_url": { "type": ["string", "null"], "format": "uri" },
    "frequency_cap": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["max_posts", "window_seconds"],
      "properties": {
        "max_posts": { "type": "integer", "minimum": 0 },
        "window_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "self_promo_allowed": { "type": "boolean" },
    "link_policy": { "enum": ["allowed", "canonical_only", "no_links", "review_required"] },
    "disclosure_required": { "type": "boolean" },
    "automation_allowed": { "type": "boolean" },
    "connector_key": { "type": "string", "minLength": 1 },
    "relevance_score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "relevance_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "last_certified_at": { "type": ["string", "null"], "format": "date-time" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title_max_chars": { "type": ["integer", "null"], "minimum": 0 },
        "body_max_chars": { "type": ["integer", "null"], "minimum": 0 },
        "links_allowed": { "type": "boolean" }
      }
    },
    "content_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["text", "image", "video_link", "audio", "article"] }
    },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
