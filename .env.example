APP_ENV=development
LOG_LEVEL=INFO
# Production requires a 24+ character APP_API_KEY. In local development it is
# optional; set it when you want to exercise the authenticated path locally.
APP_API_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=29360128
JOB_LEASE_SECONDS=900
RECERTIFICATION_MAX_AGE_DAYS=30
RECERTIFICATION_RETEST_LEAD_DAYS=2
# Direct connector calls and remote artifact URLs are development conveniences.
# Set both explicitly to true only for a protected production integration.
CONNECTOR_CONTRACT_ENABLED=true
ARTIFACT_SOURCE_FETCH_ENABLED=true
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1,lemmy,ghost,discourse,mock-platforms
# Optional asynchronous job callback. Configure both values together; callback
# URLs must use an exact host in this allowlist and receive an HMAC-SHA256 body signature.
CALLBACK_ALLOWED_HOSTS=
JOB_CALLBACK_SIGNING_SECRET=
# Add exact approved public rules-page hosts here before using source_url.
RULE_PAGE_FETCH_ENABLED=true
# Required whenever SIMULATION_MODE=false. Restrict live connector credentials
# to endpoint hosts that you own or have explicitly approved.
CONNECTOR_ALLOWED_HOSTS=localhost,127.0.0.1,lemmy,ghost,discourse,mock-platforms
APP_DB_PASSWORD=change-this-local-password
LEMMY_DB_PASSWORD=change-this-local-password
LEMMY_PICTRS_KEY=change-this-local-key
GHOST_DB_ROOT_PASSWORD=change-this-local-password
GHOST_DB_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://incubrix:change-this-local-password@postgres:5432/incubrix
SIMULATION_MODE=true
S3_BUCKET=incubrix-artifacts
S3_ENDPOINT_URL=http://s3-mock:5000
S3_ACCESS_KEY=testing
S3_SECRET_KEY=testing
S3_PUBLIC_ENDPOINT_URL=http://localhost:5000
PRESIGNED_URL_TTL_SECONDS=3600
JOB_POLL_SECONDS=1
# Platform tokens are always supplied through environment/secret store, never API payloads.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
LEMMY_JWT=
DEVTO_API_KEY=
GHOST_ADMIN_API_KEY=
GHOST_ADMIN_API_VERSION=v5.0
MOCK_DISCOURSE_KEY=local-mock-key
MOCK_DEVTO_KEY=local-mock-key
MOCK_GHOST_ADMIN_KEY=mock-key:deadbeef
PARTNER_WEBHOOK_SECRET=local-partner-secret
MASTODON_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=
MATRIX_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
HASHNODE_PERSONAL_ACCESS_TOKEN=
PEERTUBE_ACCESS_TOKEN=
# PeerTube imports remote video URLs. Add only source domains you own or approve.
MEDIA_IMPORT_ALLOWED_HOSTS=
CERTIFICATION_ALLOWED_HOSTS=localhost,127.0.0.1,lemmy,ghost,discourse,mock-platforms
