{
  "kind": "connector",
  "connector_key": "discourse",
  "method": "validate",
  "body": {
    "rendition": {"title": "Image check", "body": "Image content", "media": [{"url": "https://assets.example/image.png", "media_type": "image"}]},
    "destination": {"content_types": ["text"], "spec": {"title_max_chars": 255, "body_max_chars": 32000, "links_allowed": true}},
    "connection": {}
  },
  "expect": {"http_status": 200, "response": {"ok": false, "violations": [{"code": "MEDIA_TYPE_UNSUPPORTED"}]}}
}
